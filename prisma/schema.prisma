generator client {
  provider        = "prisma-client-js"
  output          = "../server/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model admins {
  id            String    @id
  email         String    @unique
  password_hash String
  created_at    DateTime? @default(now()) @db.Timestamp(6)
}

model alliances {
  id          String @id
  nombre      String @default("")
  tag         String @default("")
  ubicacion   String @default("")
  direccion   String @default("")
  email       String @default("")
  telefono    String @default("")
  horario     String @default("")
  dias        String @default("")
  status      String @default("partner")
  descripcion String @default("")
  imagen      String @default("")
  instagram   String @default("")
  website     String @default("")
}

model app_state {
  key        String    @id
  value      String
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

model categories {
  name          String @id
  sort_order    Int    @default(0)
  subcategories Json   @default("[]")
}

model fighters {
  id        String @id
  name      String @default("")
  title     String @default("")
  specialty String @default("")
  weight    String @default("")
  level     String @default("AMATEUR")
  record    String @default("")
  handle    String @default("")
  image     String @default("")
}

model orders {
  order_number     Int       @id @default(autoincrement())
  id               String?   @unique
  customer_name    String    @default("")
  customer_phone   String    @default("")
  customer_email   String    @default("")
  rut              String    @default("")
  comuna_region    String    @default("")
  client_order_id  String    @unique(map: "idx_orders_client_order_id", where: raw("(client_order_id <> ''::text)")) @default("")
  fulfillment      String    @default("pickup")
  payment_method   String    @default("whatsapp")
  address          String    @default("")
  notes            String    @default("")
  items            Json      @default("[]")
  total            Float     @default(0)
  status           String    @default("pending")
  mp_preference_id String    @default("")
  mp_payment_id    String    @default("")
  purchase_email_sent_at DateTime? @db.Timestamp(6)
  status_email_sent_at   DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([status], map: "idx_orders_status")
}

model product_images {
  product_id String
  sort_order Int      @default(0)
  url        String
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, sort_order])
}

model products {
  id               String           @id
  sku              String           @default("")
  label            String           @default("")
  cat              String           @default("Accesorios")
  subcat           String           @default("")
  active           Int              @default(1)
  is_featured      Int              @default(0)
  price            Float            @default(0)
  stock            Int              @default(0)
  variant          String           @default("")
  name             String           @default("")
  desc             String           @default("")
  badge            String           @default("")
  sizes            Json             @default("[]")
  stock_by_size    Json             @default("{}")
  featured_order   Int?
  is_weekly_offer  Int              @default(0)
  offer_price      Float?
  offer_label      String           @default("")
  offer_start_date String?
  offer_end_date   String?
  offer_order      Int              @default(0)
  product_images   product_images[]
  product_variants product_variants[]

  @@index([cat], map: "idx_products_cat")
}

model product_variants {
  product_id String
  size       String
  sku        String   @default("")
  stock      Int      @default(0)
  active     Boolean  @default(true)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, size])
  @@index([product_id], map: "idx_product_variants_product_id")
}

model sessions {
  id             String    @id
  is_admin       Int       @default(0)
  cart           Json      @default("[]")
  checkout_prefs Json      @default("{}")
  expires_at     String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
}
