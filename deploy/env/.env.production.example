# ==============================================================================
# GALVAR SPORT - PRODUCCION VPS + CLOUDFLARE
# ==============================================================================

NODE_ENV=production
PORT=3001

# URL publica final. Debe coincidir con Cloudflare, Nginx y Mercado Pago.
BASE_URL="https://galvarsport.cl"
STORE_URL="https://galvarsport.cl"
CORS_ORIGINS="https://galvarsport.cl,https://www.galvarsport.cl"

# ==============================================================================
# POSTGRESQL
# ==============================================================================

PGHOST="localhost"
PGUSER="tienda_user"
PGDATABASE="galvar_db"
PGPASSWORD="CAMBIAR_PASSWORD_POSTGRES"
PGPORT=5432
PGSSL=false

DATABASE_URL="postgresql://tienda_user:CAMBIAR_PASSWORD_POSTGRES@localhost:5432/galvar_db?schema=public"

# ==============================================================================
# ADMIN
# ==============================================================================

ADMIN_EMAIL="admin@galvarsport.cl"
ADMIN_PASSWORD="CAMBIAR_POR_FRASE_LARGA_UNICA"
BCRYPT_ROUNDS=12
ADMIN_SESSION_TTL_MINUTES=60
VITE_ADMIN_IDLE_TIMEOUT_MINUTES=60

# ==============================================================================
# CORREOS
# ==============================================================================

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="ventas@galvarsport.cl"
SMTP_PASS="CAMBIAR_APP_PASSWORD_GMAIL"
ADMIN_NOTIFICATION_EMAIL="ventas@galvarsport.cl"

STORE_CONTACT_EMAIL="ventas@galvarsport.cl"
STORE_CONTACT_PHONE="+56 9 1234 5678"
STORE_INSTAGRAM="@galvar_sport"

EMAIL_TIMEOUT_MS=15000

# ==============================================================================
# MERCADO PAGO - INICIAR CON TEST Y CAMBIAR A APP_USR SOLO AL PASAR A PRODUCCION
# ==============================================================================

VITE_MP_PUBLIC_KEY="TEST-tu_public_key_aqui"
MP_ACCESS_TOKEN="TEST-tu_access_token_aqui"
MP_WEBHOOK_SECRET="CAMBIAR_WEBHOOK_SECRET"
VITE_MP_ENABLE_WALLET=true
VITE_MP_ENABLE_CARDS=true

MP_PENDING_CLEANUP_ENABLED=true
MP_PENDING_EXPIRY_MINUTES=30
MP_PENDING_CLEANUP_INTERVAL_MINUTES=10

# ==============================================================================
# LIMITES Y CONTACTO
# ==============================================================================

JSON_BODY_LIMIT="15mb"
MAX_IMAGE_UPLOAD_MB=8
VITE_WHATSAPP_NUMBER="56971413309"
