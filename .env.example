# ==============================================================================
# CONFIGURACIÓN DE CORREOS (NODEMAILER)
# ==============================================================================

# El host SMTP (Por defecto: smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"

# El puerto SMTP (Por defecto: 465 para SSL/Seguro)
SMTP_PORT=465

# Tu dirección de correo de Gmail (ej: ventas@galvarsport.com)
SMTP_USER="tu_correo@gmail.com"

# Tu "App Password" (Contraseña de Aplicación) de Google.
# IMPORTANTE: NO es tu contraseña normal de Gmail.
# Cómo obtenerla:
# 1. Ve a "Gestionar tu cuenta de Google" -> "Seguridad"
# 2. Activa "Verificación en 2 pasos"
# 3. Busca "Contraseñas de aplicaciones" en la barra de búsqueda superior
# 4. Crea una nueva aplicación (ej: "Galvar Web") y copia los 16 caracteres aquí.
SMTP_PASS="xxxx xxxx xxxx xxxx"

# ==============================================================================
# DATOS DE LA TIENDA (Para las plantillas de correo)
# ==============================================================================

# El correo que recibirá las notificaciones de ventas (puede ser el mismo que SMTP_USER)
ADMIN_NOTIFICATION_EMAIL="tu_correo_admin@gmail.com"

# Datos de contacto mostrados en el correo al cliente
STORE_CONTACT_EMAIL="contacto@galvarsport.com"
STORE_CONTACT_PHONE="+56 9 1234 5678"
STORE_INSTAGRAM="@galvar_sport"
STORE_URL="https://tu_dominio.com"

# ==============================================================================
# OTRAS CONFIGURACIONES DEL SERVIDOR
# ==============================================================================
PORT=3001
ADMIN_EMAIL="tu_correo@gmail.com"
ADMIN_PASSWORD="admin_secret_password"
DB_TYPE="sqlite" # o "postgres"

# CONFIGURACIÓN POSTGRESQL (Si DB_TYPE="postgres")
PGHOST="localhost"
PGUSER="postgres"
PGDATABASE="galvar_sport"
PGPASSWORD="tu_password"
PGPORT=5432


# ==============================================================================
# MERCADO PAGO
# ==============================================================================
MP_ACCESS_TOKEN="tu_access_token_aqui"
MP_WEBHOOK_SECRET="tu_secreto_webhook_aqui"

# ==============================================================================
# CONTACTO
# ==============================================================================
VITE_WHATSAPP_NUMBER="56971413309"
