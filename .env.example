# ==============================================================================
# CONFIGURACIÓN DE CORREOS (NODEMAILER)
# ==============================================================================

# El host SMTP (Por defecto: smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"

# El puerto SMTP (Por defecto: 465 para SSL/Seguro)
SMTP_PORT=465

# Tu dirección de correo de Gmail (ej: ventas@galvarsport.com)
SMTP_USER="tu_correo@gmail.com"

# Tu "App Password" (Contraseña de Aplicación) de Google.
# IMPORTANTE: NO es tu contraseña normal de Gmail.
# Cómo obtenerla:
# 1. Ve a "Gestionar tu cuenta de Google" -> "Seguridad"
# 2. Activa "Verificación en 2 pasos"
# 3. Busca "Contraseñas de aplicaciones" en la barra de búsqueda superior
# 4. Crea una nueva aplicación (ej: "Galvar Web") y copia los 16 caracteres aquí.
SMTP_PASS="xxxx xxxx xxxx xxxx"

# ==============================================================================
# DATOS DE LA TIENDA (Para las plantillas de correo)
# ==============================================================================

# El correo que recibirá las notificaciones de ventas (puede ser el mismo que SMTP_USER)
ADMIN_NOTIFICATION_EMAIL="tu_correo_admin@gmail.com"

# Datos de contacto mostrados en el correo al cliente
STORE_CONTACT_EMAIL="contacto@galvarsport.com"
STORE_CONTACT_PHONE="+56 9 1234 5678"
STORE_INSTAGRAM="@galvar_sport"
STORE_URL="https://tu_dominio.com"
STORE_PICKUP_LOCATION_NAME="Galvar Sport - Antofagasta"
STORE_PICKUP_ADDRESS="Clodomiro Rozas 965, Antofagasta, Chile"
VITE_STORE_PICKUP_LOCATION_NAME="Galvar Sport - Antofagasta"
VITE_STORE_PICKUP_ADDRESS="Clodomiro Rozas 965, Antofagasta, Chile"

# ==============================================================================
# OTRAS CONFIGURACIONES DEL SERVIDOR
# ==============================================================================
NODE_ENV=development
PORT=3001
ADMIN_EMAIL="tu_correo@gmail.com"
ADMIN_PASSWORD="cambia_esto_por_una_frase_larga_y_unica"
BCRYPT_ROUNDS=12
ADMIN_SESSION_TTL_MINUTES=5
VITE_ADMIN_IDLE_TIMEOUT_MINUTES=5
JSON_BODY_LIMIT="15mb"
MAX_IMAGE_UPLOAD_MB=8
BASE_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# CONFIGURACIÓN POSTGRESQL
PGHOST="localhost"
PGUSER="tienda_user"
PGDATABASE="galvar_db"
PGPASSWORD="tu_password"
PGPORT=5432
PGSSL=false

DATABASE_URL="postgresql://tienda_user:tu_password@localhost:5432/galvar_db?schema=public"

# ==============================================================================
# MERCADO PAGO
# ==============================================================================
VITE_MP_PUBLIC_KEY="TEST-tu_public_key_aqui"
MP_ACCESS_TOKEN="TEST-tu_access_token_aqui"
MP_WEBHOOK_SECRET="tu_secreto_webhook_aqui"
VITE_MP_ENABLE_WALLET=true
VITE_MP_ENABLE_CARDS=true

MP_PENDING_CLEANUP_ENABLED=true
MP_PENDING_EXPIRY_MINUTES=30
MP_PENDING_CLEANUP_INTERVAL_MINUTES=10

# ==============================================================================
# CONTACTO
# ==============================================================================
VITE_WHATSAPP_NUMBER="56971413309"
